# BRI Explorer runs without any API keys.
#
# Variables prefixed with VITE_ are embedded into the public JavaScript bundle,
# so never put secrets in them. Secrets belong in Netlify environment variables read by Netlify
# Functions (netlify/functions/*), never in VITE_ variables.

# Supabase Auth (email login). Public values: project URL + publishable key.
# Leave unset to run the site without login. NEVER use the secret key here.
VITE_SUPABASE_URL=https://wfgcnwsfftjsgqtcwlyd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_iEe8hTQ9fdIOsSSJe1KJIw_PXj0IMN7

# Optional: a label tile layer to use instead of the built-in country names
# ({s},{z},{x},{y},{r}; {theme} becomes light or dark). Tile keys end up in the
# public bundle, so only use a key that the provider restricts to your domain.
# VITE_TILE_URL=https://example.com/tiles/{theme}/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# ---- Agents (server-side only; set this in Netlify, not here) ----
# The news collector and Project Watcher use free sources (RSS, GDELT) and
# need no API key; they only need this to save results to Supabase.
# SUPABASE_SERVICE_ROLE_KEY=...           secret (Supabase secret / service_role key)
